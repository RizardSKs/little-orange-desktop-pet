{
  "name": "little-orange-desktop-pet",
  "version": "1.1.0",
  "description": "小橙子 Windows 桌面宠物",
  "main": "dist-electron/main/main.js",
  "author": "小橙子桌宠",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.main.json --watch\" \"wait-on http://127.0.0.1:5173 dist-electron/main/main.js && set VITE_DEV_SERVER_URL=http://127.0.0.1:5173&& electron .\"",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.main.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:win": "npm run build && electron-builder --win portable nsis --x64",
    "dist:update": "npm run build && electron-builder --config electron-builder.update.cjs --win nsis --x64 && node scripts/write_update_manifest.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "cn.littleorange.desktop.pet",
    "productName": "小橙子桌宠",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*", "assets/**/*", "package.json"],
    "win": { "target": ["portable", "nsis"], "icon": "assets/icon.png", "artifactName": "${productName}-${version}-${arch}.${ext}" },
    "portable": { "artifactName": "小橙子桌宠-Portable-${version}-x64.${ext}" },
    "nsis": {
      "artifactName": "小橙子桌宠-Setup-${version}-x64.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "小橙子桌宠"
    }
  }
}
