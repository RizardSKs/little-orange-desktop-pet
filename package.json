{
  "name": "little-orange-desktop-pet",
  "version": "1.2.7",
  "description": "小橙子 Windows 桌面宠物",
  "main": "dist-electron/main/main.js",
  "author": "小橙子桌宠",
  "license": "UNLICENSED",
  "private": true,
  "releaseMetadata": {
    "compatibleFrom": "1.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.main.json --watch\" \"wait-on http://127.0.0.1:5173 dist-electron/main/main.js && set VITE_DEV_SERVER_URL=http://127.0.0.1:5173&& electron .\"",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.main.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:release": "node scripts/verify_release_artifacts.mjs",
    "dist:win": "npm run dist:setup",
    "dist:setup": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:update": "npm run build && electron-builder --config electron-builder.update.cjs --win nsis --x64 --publish never && node scripts/write_update_manifest.mjs"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest",
    "uiohook-napi": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "cn.littleorange.desktop.pet",
    "productName": "小橙子桌宠",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png",
      "artifactName": "${productName}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Little-Orange-Desktop-Pet-Setup-x64.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "小橙子桌宠",
      "deleteAppDataOnUninstall": false
    }
  }
}
